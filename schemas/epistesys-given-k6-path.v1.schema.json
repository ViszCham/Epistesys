{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epistesys:given-k6-path:v1",
  "title": "Explicit Given K6 path input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_hex", "final_hex", "edges", "namespace", "scope", "probes"],
  "properties": {
    "schema_version": {"const": "epistesys-given-k6-path.v1"},
    "root_hex": {"$ref": "#/$defs/term"},
    "final_hex": {"$ref": "#/$defs/term"},
    "edges": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/edge"}},
    "namespace": {"$ref": "#/$defs/namespace"},
    "scope": {"$ref": "#/$defs/scope"},
    "probes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/probe"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "term": {"type": "string", "pattern": "^([0-9a-f]{2})*$", "maxLength": 131072},
    "namespace": {"type": "object", "additionalProperties": false,
      "required": ["id_hex", "revision_hex"],
      "properties": {"id_hex": {"$ref": "#/$defs/id"}, "revision_hex": {"$ref": "#/$defs/id"}}},
    "edge": {"type": "object", "additionalProperties": false,
      "required": ["from_hex", "to_hex", "namespace"],
      "properties": {"from_hex": {"$ref": "#/$defs/term"}, "to_hex": {"$ref": "#/$defs/term"}, "namespace": {"$ref": "#/$defs/namespace"}}},
    "scope": {"type": "object", "additionalProperties": false,
      "required": ["id_hex", "baseline_hex", "root_goal_hex", "probes_hex", "policy_hex"],
      "properties": {"id_hex": {"$ref": "#/$defs/id"}, "baseline_hex": {"$ref": "#/$defs/id"}, "root_goal_hex": {"$ref": "#/$defs/id"}, "probes_hex": {"$ref": "#/$defs/id"}, "policy_hex": {"$ref": "#/$defs/id"}}},
    "probe": {"type": "object", "additionalProperties": false,
      "required": ["obligation_hex", "property_hex", "path", "kind", "weight_numerator", "weight_denominator", "hard"],
      "properties": {"obligation_hex": {"$ref": "#/$defs/id"}, "property_hex": {"$ref": "#/$defs/id"},
        "path": {"type": "array", "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 1024}},
        "kind": {"enum": ["node_kind", "symbol", "boolean", "integer", "operator", "arity", "binder", "sort", "bound_index"]},
        "weight_numerator": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "weight_denominator": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}, "hard": {"type": "boolean"}}}
  },
  "$comment": "The 256 KiB raw input limit, nonzero namespace pins, valid K6, unique probes and composable exact endpoints are separately enforced by the profile, not inferred from schema validity."
}
